{
  "name": "league-jax",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "site": "vite --host 127.0.0.1 --port 4173 site",
    "site:prepare-deploy": "bun run ./scripts/prepare-site-deploy.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "release:notes:dry-run": "bun run ./scripts/dry-run-release-notes.ts",
    "bump:patch": "bun run ./scripts/bump-version.ts patch",
    "bump:minor": "bun run ./scripts/bump-version.ts minor",
    "bump:major": "bun run ./scripts/bump-version.ts major",
    "lint:biome": "bunx biome check .",
    "lint:biome:fix": "bunx biome check --write .",
    "lint:clippy": "cargo clippy",
    "lint:check_all": "bun run lint:biome && bun run lint:clippy",
    "lint:fix_all": "bun run lint:biome:fix && bun run lint:clippy",
    "typecheck": "tsc --noEmit",
    "generate_updater_manifest": "bun run ./scripts/generate-updater-manifest.ts",
    "sync_rs_types": "cargo test --manifest-path src-tauri/Cargo.toml export_bindings && bunx biome check --write ./src/bindings && bun run typecheck"
  },
  "dependencies": {
    "@ark-ui/solid": "^5.36.2",
    "@dagrejs/dagre": "^3.0.0",
    "@dschz/solid-flow": "^0.1.4",
    "@solid-primitives/i18n": "^2.2.1",
    "@solid-primitives/keyed": "^1.5.3",
    "@solidjs/router": "^0.16.1",
    "@tanstack/solid-table": "^8.21.3",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@thaterror/core": "^1.0.1",
    "@vanilla-extract/css": "^1.20.1",
    "@vanilla-extract/dynamic": "^2.1.5",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "graphology": "^0.26.0",
    "lucide-solid": "^1.16.0",
    "pino": "^10.3.1",
    "remeda": "^2.34.1",
    "smol-toml": "^1.6.1",
    "solid-js": "^1.9.13",
    "solid-motionone": "^1.0.4",
    "solid-zustand": "^2.0.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@rollup/plugin-swc": "^0.4.0",
    "@swc/core": "^1.15.40",
    "@tauri-apps/cli": "^2.11.2",
    "@types/bun": "^1.3.14",
    "clerc": "^1.3.1",
    "git-cliff": "^2.13.1",
    "graphology-types": "^0.24.8",
    "typescript": "~6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-solid": "^2.11.12"
  }
}
